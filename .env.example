# MySQL Database Configuration
# Copy this file to .env and set secure values
# NEVER commit the .env file to source control

# MySQL root password (used only for database initialization)
MYSQL_ROOT_PASSWORD=change_this_root_password

# Application database credentials (least-privilege user)
MYSQL_USER=acme_app
MYSQL_PASSWORD=change_this_app_password
MYSQL_DATABASE=acme

# MySQL connection settings (for application)
MYSQL_HOST=localhost
MYSQL_PORT=3306
